   비워두면 이 파일에 내장된 데이터로 그대로 작동합니다.
   시트 주소 .../spreadsheets/d/[이 부분이 ID]/edit
   시트는 "링크가 있는 모든 사용자 · 뷰어" 공유 필요, 탭 이름은 SHEET_NAME 과 일치. */
const SHEET_ID   = '';        // 예: '1AbC...xyz'  (비워두면 내장 데이터 사용)
const SHEET_NAME = '금형';
/* ============================================= */

let MAP = {};
function indexData(rows){
  DATA = rows;
  MAP = {};
  DATA.forEach(d => { d._k = NORM(d.partno); if(!(d._k in MAP)) MAP[d._k] = d; });
  document.getElementById('cTot').textContent = DATA.length.toLocaleString();
}
indexData(DATA);   // 내장 데이터로 즉시 작동

/* --- 시트에서 불러오기 (SHEET_ID 있을 때만) --- */
const COLMAP = {
  '품번':'partno','part no':'partno','partno':'partno','molde':'partno','no. de molde':'partno','no de molde':'partno',
  '금형명':'name','품명':'name','name':'name','descripcion':'name','descripción':'name',
  '차종':'model','model':'model','proyecto':'model',
  '중량':'weight','중량(kg)':'weight','weight':'weight','peso':'weight','peso(kg)':'weight',
  '현재위치':'location','위치':'location','location':'location','ubicacion':'location','ubicación':'location','ubic.':'location',
  'planta':'planta','공장':'planta',
  '금형상태':'status','상태':'status','status':'status','estado':'status'
};
async function fetchSheet(){
  const url='https://docs.google.com/spreadsheets/d/'+SHEET_ID+'/gviz/tq?tqx=out:json&headers=1&sheet='+encodeURIComponent(SHEET_NAME)+'&_='+Date.now();
  const res=await fetch(url,{cache:'no-store'});
  if(!res.ok) throw new Error('시트 응답 '+res.status);
  const t=await res.text(), s=t.indexOf('{'), e=t.lastIndexOf('}');
  const tbl=JSON.parse(t.slice(s,e+1)).table;
  const cols=tbl.cols.map(c=>COLMAP[(c.label||c.id||'').toString().trim().toLowerCase()]||null);
  if(!cols.includes('partno')) throw new Error('품번 열 없음');
  const rows=[];
  tbl.rows.forEach(r=>{ if(!r.c) return;
    const o={partno:'',name:'',model:'',weight:'',location:'',planta:'',status:''};
    r.c.forEach((cell,i)=>{ const k=cols[i]; if(!k) return; let v=cell&&cell.v!=null?cell.v:'';
      if(k==='weight'){ if(v===''){o[k]='';return;} const n=typeof v==='number'?v:parseFloat(String(v).replace(/,/g,'')); o[k]=isNaN(n)?'':n; }
      else o[k]=String(v).trim(); });
    if(NORM(o.partno)) rows.push(o);
  });
  if(!rows.length) throw new Error('데이터 없음');
  return rows;
}
const _foot=document.querySelector('.foot');
async function loadSheet(){
  if(!SHEET_ID){ return; }   // 내장 데이터 사용, footer 그대로
  if(_foot) _foot.textContent='시트에서 불러오는 중… / Cargando…';
  try{
    const rows=await fetchSheet();
    indexData(rows);
    if(q && q.value) search();
    if(_foot){ const d=new Date(),p=n=>String(n).padStart(2,'0');
      _foot.textContent='구글 시트 기준 · 갱신 '+d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+' '+p(d.getHours())+':'+p(d.getMinutes()); }
  }catch(err){
    if(_foot) _foot.innerHTML='<span style="color:var(--amber)">시트 연결 실패 — 내장 데이터 표시 중 ('+esc(err.message)+')</span>';
  }
}

const q=document.getElementById('q'), out=document.getElementById('out'), clr=document.getElementById('clr');
let activeIdx=-1, current=[];

function statusStyle(s){
  const t=(s||'').toLowerCase();
  if(t.includes('양산')||t.includes('produc')) return {c:'var(--green)',label:s||'-'};
  if(t.includes('obsolet')) return {c:'var(--gray)',label:s};
  if(t.includes('desarrollo')&&!t.includes('canc')) return {c:'var(--blue)',label:s};
  if(t.includes('canc')) return {c:'var(--red)',label:s};
  if(t==='del') return {c:'var(--red)',label:s};
  return {c:'var(--amber)',label:s||'-'};
}
function esc(x){return (x==null?'':String(x)).replace(/[&<>]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]));}
function wfmt(w){ return (w===''||w==null)?'':Number(w).toLocaleString(undefined,{maximumFractionDigits:1}); }
function val(v,cls){ if(v===''||v==null) return '<div class="val empty">— 정보 없음</div>'; return '<div class="val '+(cls||'')+'">'+esc(v)+'</div>'; }


/* ==================== 공장 도면 위치 표시 ====================
   CELL: 도면상 각 위치칸의 사각형 [x, y, 너비, 높이] (이미지 1256x674 기준)
   위치가 어긋나면 아래 숫자만 바꾸면 됩니다. */
const CELL = {
  E4:[239,68,26,20], E2:[265,68,26,20], A4:[291,68,26,20], A2:[318,68,26,20], B2:[344,68,26,20], B1:[370,68,26,20],
  E3:[239,103,26,20], E1:[265,103,26,20], A3:[291,103,26,20], A1:[318,103,26,20], B3:[344,103,26,20], F1:[370,103,26,20],
  C1:[166,154,26,18], C2:[198,154,26,18], C3:[230,154,26,18], D2:[262,154,26,18], F3:[294,154,26,18], F4:[324,154,26,18],
  D5:[166,181,24,18], D4:[192,181,24,18], D3:[218,181,24,18], D1:[244,181,24,18], C4:[270,181,24,18], B4:[296,181,24,18], F2:[323,181,24,18],
  BD1:[353,152,27,18], BD2:[381,152,27,18], BD3:[409,152,27,18],
  'BD5-1-3':[169,218,70,40], 'BD4-1-2':[244,218,60,40],
  'BD6-1-4':[181,297,81,92],
  BD8:[181,432,40,30], BD7:[223,432,40,30],
  BD9:[530,529,82,92], BD10:[86,240,18,90],
  AT1:[110,210,10,12], AT2:[119,210,10,12], AT3:[128,210,10,12],
  AT4:[118,224,18,11], AT5:[118,238,18,11], AT6:[118,251,18,11], AT7:[118,268,18,11],
  AT8:[118,283,18,11], AT9:[118,298,18,11], AT10:[116,313,20,11],
  AT12:[110,344,14,12], AT11:[125,344,14,12],
  AM1:[29,235,11,90], AM2:[42,235,11,90], AM3:[55,235,11,90], AM4:[68,235,11,42], AM5:[68,282,11,42]
};
function locToCell(loc){
  loc=(loc||'').toString().toUpperCase().trim();
  if(!loc) return {cell:null, reason:'blank'};
  let m=loc.match(/^([A-F])([1-5])[1-6]$/);
  if(m){ const c=m[1]+m[2]; return {cell:c, has:CELL[c]!=null}; }
  m=loc.match(/^AT0?(\d{1,2})$/); if(m){ const c='AT'+parseInt(m[1],10); return {cell:c, has:CELL[c]!=null}; }
  m=loc.match(/^AM0?(\d)$/);      if(m){ const c='AM'+parseInt(m[1],10); return {cell:c, has:CELL[c]!=null}; }
  if(loc==='BD10') return {cell:'BD10', has:true};
  m=loc.match(/^BD([1-9])(?:-(\d))?$/);
  if(m){ const g=m[1], sub=m[2];
    if('123789'.includes(g)&&!sub) return {cell:'BD'+g, has:CELL['BD'+g]!=null};
    if(g==='4') return {cell:'BD4-1-2', has:true};
    if(g==='5') return {cell:'BD5-1-3', has:true};
    if(g==='6') return {cell:'BD6-1-4', has:true};
  }
  return {cell:null, reason:'offmap'};
}
const mapBox=document.getElementById('mapBox'), mapLbl=document.getElementById('mapLbl'),
      mapNote=document.getElementById('mapNote'), hlRect=document.getElementById('hl'),
      hlring=document.getElementById('hlring'), mapScroll=document.getElementById('mapScroll'),
      mapZoom=document.getElementById('mapZoom');
function showOnMap(loc){
  mapBox.style.display='block';
  const r=locToCell(loc);
  if(r.cell && r.has){
    const [x,y,w,hh]=CELL[r.cell], pad=5, X=x-pad, Y=y-pad, W=w+pad*2, H=hh+pad*2;
    [hlRect,hlring].forEach(el=>{ el.setAttribute('x',X); el.setAttribute('y',Y); el.setAttribute('width',W); el.setAttribute('height',H); });
    hlRect.style.display=hlring.style.display='';
    mapLbl.innerHTML='위치 <b>'+esc(loc)+'</b> · 도면칸 <b>'+esc(r.cell)+'</b>';
    mapNote.style.display='none'; mapScroll.style.display='';
    requestAnimationFrame(()=>centerHighlight(X+W/2, Y+H/2));
  } else {
    hlRect.style.display=hlring.style.display='none';
    if(r.reason==='blank'){ mapLbl.textContent='위치 정보 없음'; mapNote.innerHTML='이 금형은 위치가 등록되어 있지 않습니다.'; }
    else if(r.cell){ mapLbl.innerHTML='위치 <b>'+esc(loc)+'</b>'; mapNote.innerHTML='<b>'+esc(r.cell)+'</b> 랙은 이 도면에 표시되지 않았습니다.'; }
    else { mapLbl.innerHTML='위치 <b>'+esc(loc)+'</b>'; mapNote.innerHTML='이 위치(<b>'+esc(loc)+'</b>)는 이 공장 도면에 없는 구역입니다.<br><span style="color:var(--ink-faint)">Z구역·모델명 구역 등은 도면 범위 밖입니다.</span>'; }
    mapNote.style.display='block'; mapScroll.style.display='none';
  }
}
function centerHighlight(cx, cy){
  const svg=document.getElementById('mapSvg'), scale=svg.clientWidth/1256;
  mapScroll.scrollLeft = cx*scale - mapScroll.clientWidth/2;
  mapScroll.scrollTop  = cy*scale - mapScroll.clientHeight/2;
}
mapZoom.onclick=()=>{
  const big=mapScroll.classList.toggle('big'); mapZoom.textContent=big?'축소':'확대';
  const x=+hlRect.getAttribute('x')||0, y=+hlRect.getAttribute('y')||0,
        w=+hlRect.getAttribute('width')||0, hh=+hlRect.getAttribute('height')||0;
  requestAnimationFrame(()=>centerHighlight(x+w/2, y+hh/2));
};
function hideMap(){ mapBox.style.display='none'; }

function renderCard(d){
  const st=statusStyle(d.status); const wt=wfmt(d.weight);
  out.innerHTML = `
   <div class="card"><div class="top">
       <div class="pnbig">${esc(d.partno)}</div>
       ${d.name?`<div class="name">${esc(d.name)}</div>`:''}
       <span class="badge" style="background:${st.c}1f;color:${st.c}"><span class="dot" style="background:${st.c}"></span>${esc(st.label||'-')}</span>
     </div><div class="grid">
       <div class="cell full"><div class="lbl">차종 <span class="es">PROYECTO</span></div>${val(d.model,'')}</div>
       <div class="cell"><div class="lbl">중량 <span class="es">PESO</span></div>${wt!==''?`<div class="val mono">${wt}<small>kg</small></div>`:val('')}</div>
       <div class="cell"><div class="lbl">현재위치 <span class="es">UBIC.</span></div>${val(d.location,'mono')}</div>
       <div class="cell"><div class="lbl">PLANTA <span class="es">공장</span></div>${val(d.planta,'mono')}</div>
       <div class="cell"><div class="lbl">금형상태 <span class="es">ESTADO</span></div><div class="val" style="color:${st.c};font-size:17px">${esc(d.status||'—')}</div></div>
     </div></div>`;
  showOnMap(d.location);
}
function emptyState(){ if(typeof hideMap==='function') hideMap();
  out.innerHTML = `<div class="empty-state">
    <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>
    <p>품번을 입력해 정보를 조회하세요.<br>Escriba el número de molde para buscar.</p></div>`;
}
function hl(pn,k){ const u=pn.toUpperCase(); const ri=u.indexOf(k[0]); if(k===''||ri<0) return esc(pn);
  return esc(pn.slice(0,ri))+'<em>'+esc(pn.slice(ri,ri+k.length))+'</em>'+esc(pn.slice(ri+k.length)); }
function renderList(list,k){ if(typeof hideMap==='function') hideMap();
  current=list; activeIdx=-1;
  if(!list.length){ out.innerHTML=`<div class="noresult">일치하는 품번이 없습니다<br><b>${esc(q.value)}</b><br><span style="font-size:12px">No se encontró el molde</span></div>`; return; }
  out.innerHTML='<div class="sugg">'+list.map((d,i)=>{const st=statusStyle(d.status);
    return `<div class="item" data-i="${i}"><span class="dot" style="background:${st.c}"></span><span class="pn">${hl(d.partno,k)}</span><span class="nm">${esc(d.name||'')}</span></div>`;}).join('')+'</div>';
  out.querySelectorAll('.item').forEach(el=>{ el.onclick=()=>{const d=current[+el.dataset.i];q.value=d.partno;clr.classList.add('show');renderCard(d);}; });
}
function search(){
  const raw=q.value; const k=NORM(raw); clr.classList.toggle('show', raw.length>0);
  if(k===''){ emptyState(); current=[]; return; }
  const exact=MAP[k]; if(exact){ renderCard(exact); return; }
  const pre=DATA.filter(d=>d._k.startsWith(k));
  const inc=pre.length<8 ? DATA.filter(d=>!d._k.startsWith(k)&&d._k.includes(k)) : [];
  renderList(pre.concat(inc).slice(0,40), k);
}
q.addEventListener('input',search);
q.addEventListener('keydown',e=>{
  const items=out.querySelectorAll('.item'); if(!items.length) return;
  if(e.key==='ArrowDown'){e.preventDefault();activeIdx=Math.min(activeIdx+1,items.length-1);}
  else if(e.key==='ArrowUp'){e.preventDefault();activeIdx=Math.max(activeIdx-1,0);}
  else if(e.key==='Enter'){e.preventDefault();const t=activeIdx<0?0:activeIdx;items[t]&&items[t].click();return;}
  else return;
  items.forEach((el,i)=>el.classList.toggle('active',i===activeIdx));
  items[activeIdx]&&items[activeIdx].scrollIntoView({block:'nearest'});
});
clr.onclick=()=>{q.value='';clr.classList.remove('show');emptyState();q.focus();};
emptyState();

/* ---- mode switch ---- */
const single=document.getElementById('single'), batch=document.getElementById('batchPanel');
const mS=document.getElementById('mSingle'), mB=document.getElementById('mBatch');
function setMode(b){
  mB.classList.toggle('on',b); mS.classList.toggle('on',!b);
  batch.classList.toggle('show',b); single.classList.toggle('hide',b);
  if(!b && !matchMedia('(display-mode: standalone)').matches) q.focus();
}
mS.onclick=()=>setMode(false); mB.onclick=()=>setMode(true);

/* ---- batch lookup ---- */
const bin=document.getElementById('bin'), bout=document.getElementById('bout');
let lastRows=[];
function runBatch(){
  const tokens=bin.value.split(/[\s,;]+/).map(t=>t.trim()).filter(Boolean);
  const seen=new Set(); const rows=[];
  tokens.forEach(tok=>{ const k=NORM(tok); if(!k||seen.has(k))return; seen.add(k);
    const d=MAP[k]; rows.push(d?{found:true,d}:{found:false,input:tok}); });
  lastRows=rows;
  if(!rows.length){ bout.innerHTML=`<div class="noresult">붙여넣은 품번이 없습니다<br><span style="font-size:12px">Pegue los números de molde</span></div>`; return; }
  const ok=rows.filter(r=>r.found).length, no=rows.length-ok;
  let html=`<div class="summary">
    <span class="pill">전체 <b>${rows.length}</b></span>
    <span class="pill ok">찾음 <b>${ok}</b></span>
    <span class="pill no">없음 <b>${no}</b></span>
    <button class="copy" id="bcopy"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>결과 복사 (엑셀용)</button>
  </div>
  <div class="tablewrap"><div class="scroll"><table><thead><tr>
    <th>품번</th><th>차종</th><th>중량</th><th>위치</th><th>PLANTA</th><th>상태</th></tr></thead><tbody>`;
  rows.forEach(r=>{
    if(!r.found){ html+=`<tr class="miss"><td class="c-pn">${esc(r.input)}<span class="miss-tag">없음</span></td><td colspan="5" class="dash">— 데이터에 없음 / No encontrado</td></tr>`; return; }
    const d=r.d, st=statusStyle(d.status), wt=wfmt(d.weight);
    html+=`<tr><td class="c-pn">${esc(d.partno)}</td>
      <td class="c-model">${d.model?esc(d.model):'<span class="dash">—</span>'}</td>
      <td class="c-wt">${wt!==''?wt+'<small style="color:var(--ink-faint)"> kg</small>':'<span class="dash">—</span>'}</td>
      <td class="c-loc">${d.location?esc(d.location):'<span class="dash">—</span>'}</td>
      <td class="c-pl">${d.planta?esc(d.planta):'<span class="dash">—</span>'}</td>
      <td class="c-st" style="color:${st.c}">${esc(d.status||'—')}</td></tr>`;
  });
  html+='</tbody></table></div></div>';
  bout.innerHTML=html;
  document.getElementById('bcopy').onclick=copyResults;
}
function copyResults(){
  const head=['품번','차종','중량(kg)','위치','PLANTA','상태'].join('\t');
  const lines=lastRows.map(r=> r.found
    ? [r.d.partno, r.d.model, wfmt(r.d.weight), r.d.location, r.d.planta, r.d.status].join('\t')
    : [r.input,'','','','','없음'].join('\t'));
  const tsv=[head,...lines].join('\n');
  const btn=document.getElementById('bcopy');
  navigator.clipboard.writeText(tsv).then(()=>{ btn.classList.add('done'); btn.textContent='복사됨 ✓';
    setTimeout(()=>{btn.classList.remove('done');btn.innerHTML='<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>결과 복사 (엑셀용)';},1600);
  }).catch(()=>{ const ta=document.createElement('textarea');ta.value=tsv;document.body.appendChild(ta);ta.select();try{document.execCommand('copy');btn.textContent='복사됨 ✓';}catch(e){alert('복사 실패 — 길게 눌러 직접 복사하세요');}document.body.removeChild(ta); });
}
document.getElementById('bgo').onclick=runBatch;
document.getElementById('bclr').onclick=()=>{bin.value='';bout.innerHTML='';bin.focus();};
bin.addEventListener('keydown',e=>{ if((e.ctrlKey||e.metaKey)&&e.key==='Enter'){e.preventDefault();runBatch();} });

/* ---- download full list (CSV, Excel-friendly UTF-8 BOM) ---- */
function csvCell(v){ v=(v===''||v==null)?'':String(v); return /[",\n]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v; }
function downloadAll(){
  const head=['품번','금형명','차종','중량(kg)','현재위치','PLANTA','금형상태'];
  const rows=[head.join(',')];
  DATA.forEach(d=>{ rows.push([d.partno,d.name,d.model,wfmt(d.weight),d.location,d.planta,d.status].map(csvCell).join(',')); });
  const csv='\uFEFF'+rows.join('\r\n');
  const blob=new Blob([csv],{type:'text/csv;charset=utf-8;'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a'); a.href=url;
  a.download='금형리스트_'+new Date().toISOString().slice(0,10).replace(/-/g,'')+'.csv';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(url),2000);
  const b=document.getElementById('dlAll'); const html=b.innerHTML;
  b.classList.add('done'); b.textContent='내려받음 ✓';
  setTimeout(()=>{b.classList.remove('done');b.innerHTML=html;},1600);
}
document.getElementById('dlAll').onclick=downloadAll;

loadSheet();

</script>
