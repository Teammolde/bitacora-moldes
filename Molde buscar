<!DOCTYPE html>
<html lang="ko"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>금형 조회 · Buscador de Moldes</title>
<meta name="theme-color" content="#0E1014">
<style>
  :root{
    --bg:#0E1014; --panel:#171A21; --panel-2:#1E222B; --line:#2A2F3A;
    --ink:#F4F6FA; --ink-dim:#9AA3B2; --ink-faint:#646C7B;
    --amber:#F5A623; --amber-soft:rgba(245,166,35,.12);
    --green:#39C07A; --blue:#4D9EFF; --red:#F2607A; --gray:#8A93A3;
    --mono:'JetBrains Mono',ui-monospace,'SF Mono',Menlo,Consolas,monospace;
    --sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Noto Sans KR',sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{height:100%}
  body{
    background:radial-gradient(1200px 600px at 50% -10%, rgba(245,166,35,.07), transparent 60%),var(--bg);
    color:var(--ink); font-family:var(--sans);-webkit-font-smoothing:antialiased; line-height:1.45;
    padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
  }
  .wrap{max-width:680px;margin:0 auto;padding:22px 16px 60px;min-height:100%}
  header{display:flex;align-items:center;gap:12px;margin-bottom:18px}
  .mark{width:40px;height:40px;border-radius:10px;flex:none;background:linear-gradient(145deg,var(--amber),#D4860C);
    display:grid;place-items:center;box-shadow:0 4px 14px rgba(245,166,35,.28)}
  .mark svg{width:22px;height:22px;display:block}
  .ttl{display:flex;flex-direction:column;gap:1px}
  .ttl h1{font-size:16px;font-weight:700;letter-spacing:-.01em}
  .ttl span{font-size:11px;color:var(--ink-faint);font-family:var(--mono);letter-spacing:.02em}
  .count{text-align:right;font-family:var(--mono);font-size:11px;color:var(--ink-faint);line-height:1.3}
  .count b{display:block;color:var(--amber);font-size:15px}

  #install{display:none;align-items:center;gap:11px;background:var(--amber-soft);
    border:1px solid rgba(245,166,35,.35);border-radius:12px;padding:11px 12px 11px 14px;margin-bottom:14px}
  #install.show{display:flex}
  #install p{font-size:12.5px;color:var(--ink-dim);line-height:1.4;flex:1}
  #install b{color:var(--ink)}
  #install button{border:none;background:var(--amber);color:#1A1208;font-weight:700;font-size:13px;padding:9px 14px;border-radius:9px;cursor:pointer;white-space:nowrap;font-family:var(--sans)}
  #install .x{background:transparent;color:var(--ink-faint);padding:6px 8px;font-size:16px}

  .dl{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--panel);
    color:var(--ink);font-family:var(--sans);font-size:11.5px;font-weight:600;padding:7px 11px;border-radius:9px;
    cursor:pointer;white-space:nowrap;transition:.12s}
  .dl:hover{border-color:var(--amber);color:var(--amber)}
  .dl svg{width:14px;height:14px}
  .dl.done{background:var(--green);color:#06281A;border-color:transparent}
  /* mode tabs */
  .modes{display:flex;gap:4px;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:4px;margin-bottom:14px}
  .mode-btn{flex:1;border:none;background:transparent;color:var(--ink-dim);font-family:var(--sans);
    font-size:13.5px;font-weight:600;padding:10px;border-radius:8px;cursor:pointer;transition:.12s;display:flex;align-items:center;justify-content:center;gap:7px}
  .mode-btn svg{width:16px;height:16px}
  .mode-btn.on{background:var(--amber);color:#1A1208}

  .search{position:relative;margin-bottom:8px}
  .search .ico{position:absolute;left:16px;top:50%;transform:translateY(-50%);color:var(--ink-faint);pointer-events:none}
  #q{width:100%;background:var(--panel);border:1.5px solid var(--line);border-radius:14px;color:var(--ink);
    font-family:var(--mono);font-size:18px;font-weight:600;letter-spacing:.06em;padding:17px 50px 17px 46px;
    outline:none;text-transform:uppercase;transition:border-color .15s, box-shadow .15s}
  #q::placeholder{color:var(--ink-faint);letter-spacing:.02em;font-weight:500;text-transform:none}
  #q:focus{border-color:var(--amber);box-shadow:0 0 0 4px var(--amber-soft)}
  .clear{position:absolute;right:10px;top:50%;transform:translateY(-50%);width:30px;height:30px;border:none;
    background:var(--panel-2);border-radius:8px;color:var(--ink-dim);font-size:16px;cursor:pointer;display:none;place-items:center}
  .clear.show{display:grid}
  .hint{font-size:11.5px;color:var(--ink-faint);padding:2px 4px 14px;font-family:var(--mono)}

  /* batch */
  #batchPanel{display:none}
  #batchPanel.show{display:block}
  #single.hide{display:none}
  #bin{width:100%;min-height:120px;background:var(--panel);border:1.5px solid var(--line);border-radius:14px;
    color:var(--ink);font-family:var(--mono);font-size:14px;letter-spacing:.04em;line-height:1.7;
    padding:14px 16px;outline:none;text-transform:uppercase;resize:vertical;transition:border-color .15s, box-shadow .15s}
  #bin::placeholder{color:var(--ink-faint);letter-spacing:.01em;text-transform:none;line-height:1.5}
  #bin:focus{border-color:var(--amber);box-shadow:0 0 0 4px var(--amber-soft)}
  .batch-actions{display:flex;gap:8px;margin:10px 0 4px}
  .btn{border:none;border-radius:11px;font-family:var(--sans);font-size:14px;font-weight:700;padding:13px 16px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px}
  .btn svg{width:16px;height:16px}
  .btn-primary{flex:1;background:var(--amber);color:#1A1208}
  .btn-ghost{background:var(--panel-2);color:var(--ink-dim);border:1px solid var(--line)}
  .btn:active{transform:translateY(1px)}

  .summary{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:14px 2px 10px;font-family:var(--mono);font-size:12px}
  .summary .pill{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;background:var(--panel);border:1px solid var(--line);color:var(--ink-dim)}
  .summary .pill b{font-size:13px}
  .summary .ok b{color:var(--green)} .summary .no b{color:var(--red)}
  .summary .copy{margin-left:auto;background:var(--panel-2);border:1px solid var(--line);color:var(--ink);
    font-family:var(--sans);font-weight:600;font-size:12.5px;padding:7px 12px;border-radius:9px;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
  .summary .copy.done{background:var(--green);color:#06281A;border-color:transparent}

  .tablewrap{border:1px solid var(--line);border-radius:14px;overflow:hidden}
  .scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
  table{border-collapse:collapse;width:100%;min-width:560px;font-size:13px}
  thead th{background:var(--panel-2);color:var(--ink-faint);font-family:var(--mono);font-size:10px;
    letter-spacing:.06em;text-transform:uppercase;font-weight:600;text-align:left;padding:10px 12px;white-space:nowrap;position:sticky;top:0}
  tbody td{padding:11px 12px;border-top:1px solid var(--line);background:var(--panel);vertical-align:top}
  tbody tr.miss td{background:rgba(242,96,122,.06)}
  .c-pn{font-family:var(--mono);font-weight:700;letter-spacing:.03em;white-space:nowrap}
  .c-wt,.c-loc,.c-pl{font-family:var(--mono);white-space:nowrap}
  .c-model{color:var(--ink-dim)}
  .c-st{font-weight:700;white-space:nowrap}
  .miss .c-pn{color:var(--red)}
  .miss-tag{font-size:10px;color:var(--red);font-family:var(--mono);background:rgba(242,96,122,.12);padding:2px 6px;border-radius:5px;margin-left:6px}
  .dash{color:var(--ink-faint)}

  .card{background:linear-gradient(180deg,var(--panel),#13161C);border:1px solid var(--line);border-radius:18px;overflow:hidden;animation:rise .22s cubic-bezier(.2,.7,.3,1)}
  @keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .card .top{padding:18px 20px 16px;border-bottom:1px solid var(--line);position:relative}
  .card .top::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--amber)}
  .pnbig{font-family:var(--mono);font-size:27px;font-weight:800;letter-spacing:.04em;line-height:1.1}
  .name{font-size:13px;color:var(--ink-dim);margin-top:5px;word-break:break-word}
  .badge{display:inline-flex;align-items:center;gap:6px;margin-top:12px;font-size:12px;font-weight:700;padding:6px 11px;border-radius:999px;font-family:var(--mono);letter-spacing:.02em}
  .badge .dot{width:7px;height:7px;border-radius:50%}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line)}
  .cell{background:var(--panel);padding:15px 18px;min-height:78px}
  .cell.full{grid-column:1 / -1}
  .lbl{font-size:10.5px;color:var(--ink-faint);font-family:var(--mono);letter-spacing:.08em;text-transform:uppercase;display:flex;gap:6px;align-items:baseline}
  .lbl .es{color:var(--ink-faint);opacity:.7}
  .val{font-size:21px;font-weight:700;margin-top:7px;letter-spacing:-.01em;word-break:break-word}
  .val.mono{font-family:var(--mono);letter-spacing:.02em}
  .val small{font-size:12px;color:var(--ink-dim);font-weight:600;margin-left:3px}
  .val.empty{color:var(--ink-faint);font-weight:500;font-size:15px}
  .sugg{display:flex;flex-direction:column;gap:7px}
  .item{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:13px 15px;cursor:pointer;display:flex;align-items:center;gap:12px;transition:.12s}
  .item:hover,.item.active{border-color:var(--amber);background:var(--panel-2)}
  .item .pn{font-family:var(--mono);font-weight:700;font-size:15px;letter-spacing:.04em}
  .item .pn em{font-style:normal;color:var(--amber);background:var(--amber-soft);border-radius:3px;padding:0 1px}
  .item .nm{font-size:12px;color:var(--ink-dim);margin-left:auto;text-align:right;max-width:55%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .item .dot{width:7px;height:7px;border-radius:50%;flex:none}
  .empty-state,.noresult{text-align:center;padding:46px 20px;color:var(--ink-faint)}
  .empty-state svg{opacity:.35;margin-bottom:14px}
  .empty-state p{font-size:13.5px;line-height:1.6}
  .noresult b{color:var(--ink-dim);font-family:var(--mono)}
  .foot{text-align:center;margin-top:26px;font-size:10.5px;color:var(--ink-faint);font-family:var(--mono);letter-spacing:.03em}

  /* ===== 공장 도면 위치 표시 ===== */
  .mapbox{margin-top:12px;border:1px solid var(--line);border-radius:14px;background:var(--panel);overflow:hidden}
  .maphd{display:flex;align-items:center;gap:8px;padding:11px 13px;border-bottom:1px solid var(--line);font-size:12.5px;color:var(--ink-dim);font-weight:600}
  .maphd .pin{width:15px;height:15px;color:var(--red);flex:none}
  .maphd b{color:var(--ink);font-family:var(--mono)}
  .maphd .zoom{margin-left:auto;border:1px solid var(--line);background:var(--panel-2);color:var(--ink-dim);font-family:var(--sans);font-size:11.5px;font-weight:600;padding:5px 10px;border-radius:8px;cursor:pointer}
  .maphd .zoom:hover{border-color:var(--amber);color:var(--amber)}
  .mapnote{padding:13px;font-size:12.5px;color:var(--ink-faint);line-height:1.5}
  .mapnote b{color:var(--amber);font-family:var(--mono)}
  .mapscroll{overflow:auto;-webkit-overflow-scrolling:touch;background:#fff}
  .mapscroll svg{display:block;width:100%;height:auto}
  .mapscroll.big svg{width:230%}
  #hl{fill:rgba(242,96,122,.28);stroke:var(--red);stroke-width:4;animation:hlpulse 1.15s ease-in-out infinite}
  #hlring{fill:none;stroke:var(--red);stroke-width:2;opacity:.9;animation:hlring 1.15s ease-out infinite}
  @keyframes hlpulse{0%,100%{stroke-opacity:1}50%{stroke-opacity:.35}}
  @keyframes hlring{0%{stroke-width:2;opacity:.85}100%{stroke-width:10;opacity:0}}

</style>
